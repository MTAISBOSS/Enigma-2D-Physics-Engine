<Application x:Class="Enigma_Editor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Enigma_Editor.Views"
             xmlns:viewModels="clr-namespace:Enigma_Editor.ViewModels"
             xmlns:components="clr-namespace:Enigma_Editor.Views.Components"
             StartupUri="MainWindow.xaml">

    <Application.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/EditorButton.xaml" />
                <ResourceDictionary Source="Styles/HierarchyItemStyle.xaml" />
                <ResourceDictionary Source="Styles/Menus.xaml" />
                <ResourceDictionary Source="Styles/ScrollBar.xaml" />
                <ResourceDictionary Source="Styles/TextBox.xaml" />
                <ResourceDictionary Source="Styles/EditorTabControl.xaml" />
                <ResourceDictionary Source="Styles/EditorTabStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate DataType="{x:Type viewModels:CameraComponentViewModel+Body}">
                <components:CameraComponentView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:TransformViewModel+Body}">
                <components:TransformView />
            </DataTemplate>
        </ResourceDictionary>

    </Application.Resources>

</Application>