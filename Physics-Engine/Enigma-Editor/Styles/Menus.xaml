<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="ContextMenu" x:Key="EditorContextMenu">
        <Setter Property="Background" Value="#1E1B27" />
        <Setter Property="BorderBrush" Value="#3B364A" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style TargetType="MenuItem" x:Key="EditorMenuItem">
        <Setter Property="Foreground" Value="#E2E2E5" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Cursor" Value="Hand" />

        <Style.Triggers>

            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="#FF8C00" />
                <Setter Property="Foreground" Value="#111111" />
            </Trigger>

        </Style.Triggers>
    </Style>

</ResourceDictionary>