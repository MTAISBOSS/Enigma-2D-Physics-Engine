<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Hierarchy Item -->
    <Style TargetType="TreeViewItem" x:Key="HierarchyItemStyle">

        <Setter Property="Foreground" Value="#E2E2E5" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Margin" Value="0" />

        <!-- Custom hover highlight -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <!-- TreeView Item header -->
                        <Border x:Name="HoverBorder" Background="Transparent">
                            <ContentPresenter
                                ContentSource="Header"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center" />

                        </Border>

                        <!-- IMPORTANT: children appear here -->
                        <ItemsPresenter Margin="16,0,0,0" />
                    </StackPanel>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverBorder" Property="Background" Value="#363246" />
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="HoverBorder" Property="Background" Value="#FF8C00" />
                            <Setter Property="Foreground" Value="#121017" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>


            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>