<UserControl x:Class="Enigma_Editor.Views.Components.ComponentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>

        <!-- HEADER -->
        <Grid Height="26" Background="Chocolate">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Margin="8,0"
                       Text="{Binding Title}" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="?"
                        Width="18"
                        Height="18"
                        Margin="2"
                        Command="{Binding OpenDocumentationCommand}"
                        Style="{StaticResource EditorButton}" />

                <Button Content="X"
                        Width="18"
                        Height="18"
                        Margin="2"
                        Command="{Binding RemoveCommand}"
                        Style="{StaticResource EditorButton}" />

            </StackPanel>

        </Grid>

        <!-- BODY -->
        <ContentPresenter Content="{Binding BodyViewModel}" />
        <Separator />
    </StackPanel>

</UserControl>