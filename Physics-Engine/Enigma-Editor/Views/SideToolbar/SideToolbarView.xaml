<UserControl x:Class="Enigma_Editor.Views.SideToolbar.SideToolbarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border BorderThickness="1" BorderBrush="White">
        <StackPanel Background="#22202C" Orientation="Vertical">
            <Button Style="{StaticResource EditorButton}" Background="Transparent" BorderThickness="0" Width="20"
                    Height="20" Margin="0,10,0,0">
                <Image Source="pack://application:,,,/assets/icons/Asset (5).png" Width="10" />
            </Button>
            <Button Style="{StaticResource EditorButton}" Background="Transparent" BorderThickness="0" Width="20"
                    Height="20" Margin="0,10,0,0">
                <Image Source="pack://application:,,,/assets/icons/Asset (50).png" Width="10" />
            </Button>

        </StackPanel>
    </Border>

</UserControl>